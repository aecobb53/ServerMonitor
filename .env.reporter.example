# Collector + Reporter host only. Copy to .env and fill in. Never commit .env.
# Use KEY=value syntax.

# Key provided by the Control Core owner (required)
CONTROL_CORE_KEY=change-me

# Control Core address (required)
CONTROL_CORE_URL=https://control-core.example.com

# Optional: callback URL sent along with reports
# SERVER_MONITOR_CALLBACK_URL=

# Optional Collector tuning
# SERVER_MONITOR_RECONCILE_SECONDS=60
# SERVER_MONITOR_LOG_TAIL=10000
# SERVER_MONITOR_MAX_HISTORY=500
# SERVER_MONITOR_MAX_ERRORS=100

# Optional Reporter tuning
# REPORTER_RETRY_INITIAL_SECONDS=1
# REPORTER_RETRY_MAX_SECONDS=60

# Logging: DEBUG, INFO, WARNING
LOG_LEVEL=INFO
