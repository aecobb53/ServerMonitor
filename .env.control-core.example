# Control Core + UI host. Copy to .env and fill in. Never commit .env.
# Use KEY=value syntax (release.sh sources this file as shell).

# Release / compose
# GHCR_USERNAME=your-github-username

# Shared secret. Reporters must send this same value.
# Generate with: openssl rand -hex 32
CONTROL_CORE_KEY=change-me

# Admin pages
SERVER_ADMIN_PASSWORD=change-me
# JSON map of per-server/reporter admin passwords
REPORTER_ADMIN_PASSWORDS={}

# Control Core address reachable from the UI and reporter containers
CONTROL_CORE_URL=http://control-core:8000

# Optional Control Core tuning
# CONTROL_CORE_MAX_HISTORY=500
# CONTROL_CORE_MAX_ERRORS=100
# CONTROL_CORE_AGE_OFF_INTERVAL_SECONDS=

# UI: comma-separated domains whose links are rendered as trusted (empty trusts none)
TRUSTED_DOMAINS=

# Logging: DEBUG, INFO, WARNING
LOG_LEVEL=INFO
